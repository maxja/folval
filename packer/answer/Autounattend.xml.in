<?xml version="1.0" encoding="utf-8"?>
<!-- folval Phase 1 unattended install: Windows 10 Enterprise LTSC 2021
     (WIM Index 1, non-N, EditionID EnterpriseS). Target: QEMU/KVM BIOS
     (i440fx "pc"), MBR disk layout, virtio storage + network.
     Drivers are pulled from the attached virtio-win ISO; optical drive letter
     is not deterministic, so both D: and E: roots are listed as driver paths.
     The license key token __FOLVAL_WIN_KEY__ is rendered at build time by
     packer/build.sh into windowsPE UserData/ProductKey — required: keyless
     installs on this media fail ("Windows cannot read the ProductKey
     setting"). WillShowUI=OnError makes setup prompt for manual entry via
     VNC if the embedded key is rejected, instead of aborting. -->
<unattend xmlns="urn:schemas-microsoft-com:unattend" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">

  <settings pass="windowsPE">
    <component name="Microsoft-Windows-International-Core-WinPE" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <SetupUILanguage>
        <UILanguage>en-US</UILanguage>
      </SetupUILanguage>
      <InputLocale>en-US</InputLocale>
      <SystemLocale>en-US</SystemLocale>
      <UILanguage>en-US</UILanguage>
      <UserLocale>en-US</UserLocale>
    </component>

    <!-- viostor must be visible to WinPE before partitioning (virtio disk).
         NOTE: packer floppy_files copies FLATLY — every file lands at the
         floppy root, so the driver path is a:\ itself. Packages must be
         complete (netkvm.inf requires netkvmp.exe — build.sh prunes only
         pdb/md/netkvmco.exe). -->
    <component name="Microsoft-Windows-PnpCustomizationsWinPE" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <DriverPaths>
        <PathAndCredentials wcm:action="add" wcm:keyValue="1">
          <Path>a:\</Path>
        </PathAndCredentials>
      </DriverPaths>
    </component>

    <component name="Microsoft-Windows-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <DiskConfiguration>
        <Disk wcm:action="add">
          <DiskID>0</DiskID>
          <WillWipeDisk>true</WillWipeDisk>
          <CreatePartitions>
            <CreatePartition wcm:action="add">
              <Order>1</Order>
              <Type>Primary</Type>
              <Size>100</Size>
            </CreatePartition>
            <CreatePartition wcm:action="add">
              <Order>2</Order>
              <Type>Primary</Type>
              <Extend>true</Extend>
            </CreatePartition>
          </CreatePartitions>
          <ModifyPartitions>
            <ModifyPartition wcm:action="add">
              <Order>1</Order>
              <PartitionID>1</PartitionID>
              <Format>NTFS</Format>
              <Label>System</Label>
              <Active>true</Active>
            </ModifyPartition>
            <ModifyPartition wcm:action="add">
              <Order>2</Order>
              <PartitionID>2</PartitionID>
              <Format>NTFS</Format>
              <Letter>C</Letter>
              <Label>Windows</Label>
            </ModifyPartition>
          </ModifyPartitions>
        </Disk>
      </DiskConfiguration>
      <ImageInstall>
        <OSImage>
          <InstallFrom>
            <MetaData wcm:action="add">
              <Key>/IMAGE/NAME</Key>
              <Value>Windows 10 Enterprise LTSC 2021</Value>
            </MetaData>
          </InstallFrom>
          <InstallTo>
            <DiskID>0</DiskID>
            <PartitionID>2</PartitionID>
          </InstallTo>
        </OSImage>
      </ImageInstall>
      <UserData>
        <AcceptEula>true</AcceptEula>
        <ProductKey>
          <Key>__FOLVAL_WIN_KEY__</Key>
          <WillShowUI>OnError</WillShowUI>
        </ProductKey>
      </UserData>
    </component>
  </settings>

  <!-- persist virtio drivers (NetKVM, vioserial) into the installed OS -->
  <settings pass="offlineServicing">
    <component name="Microsoft-Windows-PnpCustomizationsNonWinPE" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <DriverPaths>
        <PathAndCredentials wcm:action="add" wcm:keyValue="1">
          <Path>a:\</Path>
        </PathAndCredentials>
      </DriverPaths>
    </component>
  </settings>

  <settings pass="specialize">
    <!-- Deliberately minimal: ProductKey (rejected — setup error) and TimeZone
         (unneeded) are absent. License is applied post-install (slmgr /ipk). -->
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <ComputerName>folval-win</ComputerName>
    </component>
  </settings>

  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-International-Core" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <InputLocale>en-US</InputLocale>
      <SystemLocale>en-US</SystemLocale>
      <UILanguage>en-US</UILanguage>
      <UserLocale>en-US</UserLocale>
    </component>

    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <!-- OOBE settings MUST exist in the 19041 unattend schema: an unknown
           element hard-fails the oobeSystem pass parse ("A component or setting
           ... does not exist"). HideOnlineActivationScreens was removed for
           exactly that reason; HideOnlineAccountScreens / HideLocalAccountScreen
           (schema-valid) are omitted as no-ops on LTSC (no MSA screens,
           autologon suppresses the account screen). -->
      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
        <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
        <ProtectYourPC>3</ProtectYourPC>
      </OOBE>
      <UserAccounts>
        <LocalAccounts>
          <LocalAccount wcm:action="add">
            <Name>vagrant</Name>
            <DisplayName>vagrant</DisplayName>
            <Group>Administrators</Group>
            <Password>
              <Value>vagrant</Value>
              <PlainText>true</PlainText>
            </Password>
          </LocalAccount>
        </LocalAccounts>
        <AdministratorPassword>
          <Value>vagrant</Value>
          <PlainText>true</PlainText>
        </AdministratorPassword>
      </UserAccounts>
      <AutoLogon>
        <Enabled>true</Enabled>
        <LogonCount>3</LogonCount>
        <Username>vagrant</Username>
        <Password>
          <Value>vagrant</Value>
          <PlainText>true</PlainText>
        </Password>
      </AutoLogon>
      <FirstLogonCommands>
        <!-- Order matters and failures are SILENT (logon continues):
             1. start WinRM; 2. settle; 3. flip the unidentified (SLIRP)
             network off Public — `winrm set` refuses to manage firewall
             exceptions on Public-profile NICs (0x80338169), which is exactly
             how a naive ordering silently strands the build VM without
             AllowUnencrypted; 4-5. enable the Packer communicator settings;
             6-8. elevation token over WinRM, port 5985, headless power plan. -->
        <SynchronousCommand wcm:action="add">
          <Order>1</Order>
          <CommandLine>winrm quickconfig -q</CommandLine>
          <Description>Enable WinRM service</Description>
        </SynchronousCommand>
        <SynchronousCommand wcm:action="add">
          <Order>2</Order>
          <CommandLine>timeout /t 15 /nobreak</CommandLine>
          <Description>Let adapters and WinRM service settle</Description>
        </SynchronousCommand>
        <SynchronousCommand wcm:action="add">
          <Order>3</Order>
          <CommandLine>powershell -Command "Get-NetConnectionProfile | Set-NetConnectionProfile -NetworkCategory Private"</CommandLine>
          <Description>Unidentified network to Private (winrm set prerequisite)</Description>
        </SynchronousCommand>
        <SynchronousCommand wcm:action="add">
          <Order>4</Order>
          <CommandLine>winrm set winrm/config/service @{AllowUnencrypted=&quot;true&quot;}</CommandLine>
          <Description>Allow unencrypted WinRM (Packer communicator)</Description>
        </SynchronousCommand>
        <SynchronousCommand wcm:action="add">
          <Order>5</Order>
          <CommandLine>winrm set winrm/config/service/auth @{Basic=&quot;true&quot;}</CommandLine>
          <Description>Enable WinRM basic auth (Packer communicator)</Description>
        </SynchronousCommand>
        <SynchronousCommand wcm:action="add">
          <Order>6</Order>
          <CommandLine>reg add HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\system /v LocalAccountTokenFilterPolicy /t REG_DWORD /d 1 /f</CommandLine>
          <Description>Allow elevated admin token over WinRM</Description>
        </SynchronousCommand>
        <SynchronousCommand wcm:action="add">
          <Order>7</Order>
          <CommandLine>netsh advfirewall firewall add rule name=&quot;WinRM-HTTP&quot; dir=in localport=5985 protocol=TCP action=allow</CommandLine>
          <Description>Open WinRM port 5985</Description>
        </SynchronousCommand>
        <SynchronousCommand wcm:action="add">
          <Order>8</Order>
          <CommandLine>powercfg -setactive 8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c</CommandLine>
          <Description>High performance power plan for headless build</Description>
        </SynchronousCommand>
      </FirstLogonCommands>
    </component>
  </settings>
</unattend>
