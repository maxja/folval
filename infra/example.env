# Copy to .env.secrets and fill in. Format: op://<vault>/<item>/<field>
# Everything below is consumed via `op run --env-file=.env.secrets`.

# ── Proxmox API (same token shape as automate-dz; add VM.GuestAgent.Audit
#    on /vms/300 for the IP-discovery output) ─────────────────────────────
PROXMOX_VE_ENDPOINT="https://{pve-host}:8006"
PROXMOX_VE_API_TOKEN="op://{vault}/{item}/api-token"
PROXMOX_VE_INSECURE="false"

TF_VAR_proxmox_endpoint=${PROXMOX_VE_ENDPOINT}
TF_VAR_proxmox_api_token=${PROXMOX_VE_API_TOKEN}
TF_VAR_proxmox_insecure=${PROXMOX_VE_INSECURE}

# ── Proxmox placement ──────────────────────────────────────────────────────
TF_VAR_pve_node="{pve-node-name}"
TF_VAR_pci_address="0000:01:00.0"      # documentation/audit (provisioning uses the mapping)
TF_VAR_pci_mapping_name="p1000"        # Datacenter → Resource Mappings → PCI
TF_VAR_guest_mac="52:54:00:d5:cc:4c"  # carried from folval2: keeps Windows
                                      # activation hash + DHCP reservation stable

# ── Brain (this workstation) ───────────────────────────────────────────────
# LAN IP of the workstation (wlp6s0) — the guest needs it for the gateway
# hosts-entry (Gameserver) and staging (:8080)
LAB_BRAIN_IP="192.168.x.y"

# ── Guest WinRM (image user: vagrant) ──────────────────────────────────────
GUEST_WINRM_PASSWORD="op://{vault}/{item}/vagrant-password"
