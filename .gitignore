# Vagrant
.vagrant/
*.box

# Packer
packer/isos/
packer/dl/
packer/output*/
packer_cache/

# Secrets — never commit
packer/vars/*.pkvars.hcl
*.pkvars.hcl

# Go build artifacts
server/folval-gw
server/cmd/folval-gw/folval-gw
*.test

# Captures (large binaries)
captures/pcap/*.pcap
captures/pcap/*.pcap[0-9]*
captures/pcap/*.pcapng

# Ghidra projects
re/ghidra/*.gpr
re/ghidra/*.rep/

# Editor/OS
.DS_Store

# Lab run logs (dir kept via .gitkeep; contents stay local)
logs/*
!logs/.gitkeep

# Frida probe evidence (Phase 4b) — send()/log streams tee here; contents may
# embed title identity, so everything but the keeper stays local
out/*
!out/.gitkeep
output-*.log

# Host-side steamcmd install (D5 acquisition) — downloaded artifact, never committed
host/steamcmd/

# Agent session handoff — transient, rewritten every session
.ai-memory/handoff.md

# Gateway /push/ staging dir (D5 guest-bound files) — local only;
# MANIFEST.md is the tracked exception (reproducibility record)
host/push/*
!host/push/.gitkeep
!host/push/MANIFEST.md

# Host-side Frida client venv (Phase 4a) — pinned: frida-tools==14.11.0 + frida==17.24.1
host/frida-venv/

tmp/
