# Vagrant
.vagrant/
*.box

# Packer
packer/isos/
packer/dl/
packer/output*/
packer_cache/

# Secrets — never commit
packer/vars/*.pkvars.hcl
*.pkvars.hcl

# Go build artifacts
server/folval-gw
server/cmd/folval-gw/folval-gw
*.test

# Captures (large binaries)
captures/pcap/*.pcap
captures/pcap/*.pcapng

# Ghidra projects
re/ghidra/*.gpr
re/ghidra/*.rep/

# Editor/OS
.DS_Store

# Lab run logs (dir kept via .gitkeep; contents stay local)
logs/*
!logs/.gitkeep
output-*.log

# Agent session handoff — transient, rewritten every session
.ai-memory/handoff.md
